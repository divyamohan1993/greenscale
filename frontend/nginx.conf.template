server {
    listen ${PORT} default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # static assets - aggressive cache
    location ~* \.(?:css|js|svg|png|jpg|jpeg|gif|ico|woff2|woff|ttf)$ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400, must-revalidate";
        try_files $uri =404;
    }

    # html pages - no cache (revalidate)
    location ~* \.html$ {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # backend reverse-proxy
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 15s;
    }

    # routes
    location = /          { try_files /index.html =404; add_header Cache-Control "no-cache" always; }
    location = /pitch     { try_files /pitch.html =404; add_header Cache-Control "no-cache" always; }
    location = /pitch/    { return 301 /pitch; }
    location = /report    { try_files /report.html =404; add_header Cache-Control "no-cache" always; }
    location = /report/   { return 301 /report; }
    location = /health    { return 200 'ok'; default_type text/plain; }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
